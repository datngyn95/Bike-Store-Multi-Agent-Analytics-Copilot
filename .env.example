# Bike Store Multi-Agent Analytics Copilot
# Copy this file to .env and fill secrets locally.

# Project
PROJECT_NAME=Bike Store Multi-Agent Analytics Copilot
APP_ENV=development
NODE_ENV=development

# Data paths
SOURCE_DATA_DIR=../Bike_Store_DB
RAW_DATA_DIR=raw
LOAD_TRUNCATE_BEFORE_INSERT=true

# Supabase / Postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=

# Supabase schemas
RAW_SCHEMA=raw
STAGING_SCHEMA=staging
ANALYTICS_SCHEMA=analytics
AGENT_SCHEMA=agent
AUDIT_SCHEMA=audit

# pgvector / RAG
VECTOR_STORE=pgvector
PGVECTOR_SCHEMA=agent
PGVECTOR_TABLE=rag_embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# MCP
SUPABASE_MCP_URL=https://mcp.supabase.com/mcp
CONTEXT7_API_KEY=

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Streamlit
STREAMLIT_HOST=localhost
STREAMLIT_PORT=8501

# React/Next frontend
FRONTEND_PORT=3000
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo auth
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_DEMO_USER=admin
DASHBOARD_DEMO_PASSWORD=change-me-before-demo
AUTH_COOKIE_SECRET=change-me-to-a-long-random-secret
# Local HTTP demo can use false. Set true or omit for HTTPS production.
AUTH_COOKIE_SECURE=false
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
CLIENT_ORIGIN=http://localhost:3000
CLIENT_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8000

# Copilot guardrails
COPILOT_SQL_ROW_LIMIT=100
COPILOT_SQL_TIMEOUT_SECONDS=15
COPILOT_LOG_QUERIES=true
